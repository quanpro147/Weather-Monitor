# Data pipeline — direct PostgreSQL connection (data-pipeline/fetchers/)
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Supabase (server-side — FastAPI)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (client-side — Next.js frontend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI URL (client-side — Next.js frontend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Redis
# Khi deploy lên Upstash (cloud): dùng REDIS_URL (lấy từ upstash.com)
# Khi chạy local / Docker: dùng REDIS_HOST + REDIS_PORT + REDIS_DB
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# App
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM — Gemini keys are tried in order; next key is used when current hits 429 quota
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
